# Flask Configuration
FLASK_ENV=development
DEBUG=True
# Generate a new secure key for production
# python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your_secret_key_here

# MySQL Configuration (Docker)
MYSQL_ROOT_PASSWORD=root
MYSQL_ALLOW_EMPTY_PASSWORD=no
MYSQL_RANDOM_ROOT_PASSWORD=no

# Database Configuration
# Local development: mysql+pymysql://root:root@127.0.0.1:3306/bizflow_db
# Docker development: mysql+pymysql://root:root@mysql:3306/bizflow_db
DATABASE_URI=mysql+pymysql://root:root@127.0.0.1:3306/bizflow_db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# JWT Configuration
# Generate a new secure key for production
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400

# Google Generative AI (Optional - for AI features)
GOOGLE_API_KEY=your_google_api_key_here

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
ALLOW_ALL_ORIGINS=False

# Server Configuration
APP_PORT=6868
APP_HOST=0.0.0.0

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# API Documentation
SWAGGER_ENABLED=True
